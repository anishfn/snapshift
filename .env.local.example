# Copy to .env.local and fill in. Never commit .env.local.

# SubQ Snap, the decider (required): https://console.subq.ai
SUBQ_API_KEY=

# The writer (required): a free model on OpenRouter, https://openrouter.ai
OPENROUTER_API_KEY=

# Optional. WRITER=subq makes subq-preview the writer instead (early access), using SUBQ_API_KEY.
WRITER=

# Optional model override
# OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# Optional. Reading a GitHub repository into a chat works without it for public repositories, at 60 lookups an
# hour. A token (no scopes needed for public ones) raises that limit and lets private repositories be read.
GITHUB_TOKEN=
